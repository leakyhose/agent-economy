# Copy to .env and fill in.  cp .env.example .env
# .env is gitignored and overrides anything exported in your shell.

# ---- which brain drives the agents: stub | openai | claude | baseten
# The dashboard's dropdown picks the brain for a run; this is the default it starts on.
BRAIN=openai

# ---- API keys (only the one for your brain is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BASETEN_API_KEY=

# ---- model (defaults: gpt-5.6-luna for openai, claude-haiku-4-5 for claude)
# Not used by the baseten brain, which draws a model per agent — unless you set it, which
# puts every villager on that one model (the way to A/B one model against the mixture).
MODEL=gpt-5.6-luna

# ---- baseten: the pool agents draw from, comma-separated slugs.
# Empty = the brain's own default: cheap flash-class models, none dearer than gpt-5.6-luna.
# Each agent keeps the model it drew for the whole run, and the same SEED draws the same
# line-up, so two runs can be compared. See backend/src/brains/baseten.mjs.
# BASETEN_MODELS=zai-org/GLM-5.3-Flash,deepseek-ai/DeepSeek-V4.1-Flash
# These models answer in 1-2s with their reasoning turned off (the brain turns it off), so
# the 8s DECIDE_TIMEOUT_MS is ample. Put a reasoning model in the pool and it may not be.

# ---- simulation size and speed
AGENTS=30
# DECIDE_TIMEOUT_MS=8000  # each round waits this long for every agent to decide; late ones keep their last job
# START_CASH=5000        # starting coins per agent, in cents
# START_FOOD=6
LLM_CONCURRENCY=30     # max simultaneous model calls (keep ~= AGENTS)

# ---- server / chain
# PORT=8787
# RPC=http://127.0.0.1:8899
# RUN_SECONDS=0          # >0 = run headless for N seconds, print a summary, exit
