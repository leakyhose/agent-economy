# Copy to .env and fill in.  cp .env.example .env
# .env is gitignored and overrides anything exported in your shell.

# ---- which brain drives the agents: stub | openai | baseten
# The dashboard's dropdown picks the brain for a run; this is the default it starts on.
BRAIN=openai

# ---- API keys (only the one for your brain is needed)
OPENAI_API_KEY=
BASETEN_API_KEY=

# ---- model (the openai brain's model; default gpt-5.6-luna)
# Not used by the baseten brain, which draws a model per agent — unless you set it, which
# puts every villager on that one model (the way to A/B one model against the mixture).
MODEL=gpt-5.6-luna

# ---- baseten: the pool agents draw from, comma-separated slugs.
# Empty = the brain's own default, which is four models chosen by measurement, not taste:
# cheap, quick enough for the round's clock, and willing to answer a village at once. See
# the note above DEFAULT_POOL in backend/src/brains/baseten.mjs for why each one is there.
# Each agent keeps the model it drew for the whole run and the pool is dealt evenly, so the
# same SEED gives the same line-up and two runs can be compared.
# The cheapest village is one model: BASETEN_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731
# Rank the whole catalogue by price and check the pool is served: check-brain.sh --list
# Not every model suits: GLM 5.3 Flash is metered so tightly it turns villagers away under
# load, and Kimi K2.6 reasons in prose until the round has moved on without it.

# ---- simulation size and speed
AGENTS=30
DECIDE_TIMEOUT_MS=10000  # the longest a round will wait; a villager who misses it keeps its last job
                         # 8000 is fine for one fast model; 10000 leaves room for the slower ones in a mixed pool
# DECIDE_QUORUM=0.9      # the round runs once this share have answered; the rest are left behind, as a timeout leaves them. 1 = wait for everyone
# ROUND_MS_EXPECTED=6000 # what a round is expected to take: the bank's interest period, in slots, is set from it
# BANK_RATE_PER_ROUND=0.0079   # interest per ROUND held, on the principal (0.79%)
# START_CASH=5000        # starting coins per agent, in cents
# START_FOOD=6

# ---- server / chain
# The village needs a local validator with the program loaded:  backend/scripts/validator.sh
# Build the program FIRST, and rebuild it whenever chain/programs/chain/src/lib.rs changes:
#   cd chain && anchor build
# A validator running a stale chain.so is the worst failure this project has: the ledger
# reads back as garbage, every settle is refused for InsufficientGoods, no good ever trades
# and every chart but GDP sits flat — and nothing anywhere says the program is out of date.
# PORT=8787
# RPC=http://127.0.0.1:8899
# RUN_SECONDS=0          # >0 = run headless for N seconds, print a summary, exit
