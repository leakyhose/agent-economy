{
  "name": "Economic Sandbox",
  "seed": 20260919,
  "time": {
    "tickMs": 500,
    "unit": "hour"
  },
  "resources": [
    {
      "id": "SOL",
      "onChain": true,
      "startPrice": 1,
      "divisible": true
    },
    {
      "id": "food",
      "onChain": true,
      "startPrice": 500,
      "spoilage": 0.1
    },
    {
      "id": "wood",
      "onChain": true,
      "startPrice": 300,
      "spoilage": 0.02
    },
    {
      "id": "tools",
      "onChain": true,
      "startPrice": 2000,
      "spoilage": 0
    },
    {
      "id": "labor",
      "onChain": false
    }
  ],
  "entityTypes": [
    {
      "id": "person",
      "agent": true,
      "attributes": {
        "hunger": 0,
        "skill": 1,
        "employer": null
      },
      "resources": {
        "SOL": 5000,
        "food": 6,
        "wood": 0,
        "tools": 0
      },
      "goals": [
        "Stay fed. Hunger is the one thing that will ruin you.",
        "Build up savings in the world's currency.",
        "Prefer income that keeps arriving over a single good trade."
      ]
    },
    {
      "id": "company",
      "agent": true,
      "attributes": {
        "name": "unnamed",
        "headcount": 0,
        "founder": "",
        "wage": 400
      },
      "resources": {
        "SOL": 0,
        "food": 0,
        "wood": 0,
        "tools": 0
      },
      "goals": [
        "Buy labour cheaply and sell what it produces dearly.",
        "Keep enough currency on hand to make payroll every round.",
        "Grow the workforce while each worker earns more than their wage."
      ]
    }
  ],
  "actions": [
    {
      "id": "gather_food",
      "actorTypes": [
        "person"
      ],
      "duration": 6,
      "description": "Fish or farm for food. Tools double your yield."
    },
    {
      "id": "gather_wood",
      "actorTypes": [
        "person"
      ],
      "duration": 6,
      "description": "Cut wood to sell or craft with."
    },
    {
      "id": "craft_tool",
      "actorTypes": [
        "person"
      ],
      "duration": 4,
      "description": "Turn 4 wood into a tool that doubles food yield."
    },
    {
      "id": "sell",
      "actorTypes": [
        "person",
        "company"
      ],
      "duration": 1,
      "params": [
        {
          "name": "resource",
          "type": "resource",
          "required": true
        },
        {
          "name": "quantity",
          "type": "number",
          "required": true
        },
        {
          "name": "limit",
          "type": "number",
          "required": true
        }
      ],
      "description": "Post an ask into the next market round."
    },
    {
      "id": "buy",
      "actorTypes": [
        "person",
        "company"
      ],
      "duration": 1,
      "params": [
        {
          "name": "resource",
          "type": "resource",
          "required": true
        },
        {
          "name": "quantity",
          "type": "number",
          "required": true
        },
        {
          "name": "limit",
          "type": "number",
          "required": true
        }
      ],
      "description": "Post a bid into the next market round."
    },
    {
      "id": "found_company",
      "actorTypes": [
        "person"
      ],
      "duration": 2,
      "params": [
        {
          "name": "capital",
          "type": "number",
          "required": true
        },
        {
          "name": "wage",
          "type": "number",
          "required": false
        }
      ],
      "description": "Found a company you own. You may own only one."
    },
    {
      "id": "hire",
      "actorTypes": [
        "company"
      ],
      "duration": 1,
      "targetTypes": [
        "person"
      ],
      "description": "Employ a person. They produce for you; you owe them a wage each round."
    },
    {
      "id": "idle",
      "actorTypes": [
        "person",
        "company"
      ],
      "duration": 2,
      "description": "Rest and do nothing."
    },
    {
      "id": "invest",
      "actorTypes": [
        "person"
      ],
      "targetTypes": [
        "company"
      ],
      "duration": 1,
      "params": [
        {
          "name": "amount",
          "type": "number",
          "required": true
        }
      ],
      "description": "Buy equity in a company. Stake is an SPL balance you actually hold."
    },
    {
      "id": "propose",
      "actorTypes": [
        "person",
        "company"
      ],
      "targetTypes": [
        "company"
      ],
      "duration": 1,
      "params": [
        {
          "name": "amount",
          "type": "number",
          "required": true
        },
        {
          "name": "text",
          "type": "string"
        }
      ],
      "description": "Open a treasury proposal for shareholders to vote on."
    },
    {
      "id": "vote",
      "actorTypes": [
        "person"
      ],
      "targetTypes": [
        "company"
      ],
      "duration": 1,
      "params": [
        {
          "name": "support",
          "type": "number",
          "required": true
        }
      ],
      "description": "Vote your equity weight on an open proposal."
    }
  ],
  "rules": [
    {
      "id": "craft_tool_costs_wood",
      "when": {
        "action": "craft_tool"
      },
      "require": [
        {
          "gte": [
            {
              "ref": "$actor.resources.wood"
            },
            4
          ]
        }
      ],
      "effects": [
        {
          "op": "decrement",
          "path": "$actor.resources.wood",
          "by": 4
        },
        {
          "op": "increment",
          "path": "$actor.resources.tools",
          "by": 1
        }
      ]
    },
    {
      "id": "sell_requires_stock",
      "when": {
        "action": "sell"
      },
      "require": [
        {
          "gte": [
            {
              "ref": "$actor.resources.$params.resource"
            },
            {
              "ref": "$params.quantity"
            }
          ]
        },
        {
          "gt": [
            {
              "ref": "$params.quantity"
            },
            0
          ]
        }
      ],
      "effects": [
        {
          "op": "emit",
          "event": "ask_posted"
        }
      ]
    },
    {
      "id": "buy_requires_funds",
      "when": {
        "action": "buy"
      },
      "require": [
        {
          "gte": [
            {
              "ref": "$actor.resources.SOL"
            },
            {
              "mul": [
                {
                  "ref": "$params.quantity"
                },
                {
                  "ref": "$params.limit"
                }
              ]
            }
          ]
        },
        {
          "gt": [
            {
              "ref": "$params.quantity"
            },
            0
          ]
        }
      ],
      "effects": [
        {
          "op": "emit",
          "event": "bid_posted"
        }
      ]
    },
    {
      "id": "hunger_rises",
      "when": {
        "tick": {
          "every": 8
        }
      },
      "effects": [
        {
          "op": "increment",
          "path": "$each.person.attributes.hunger",
          "by": 1
        }
      ]
    },
    {
      "id": "eating",
      "when": {
        "tick": {
          "every": 8
        }
      },
      "effects": [
        {
          "op": "emit",
          "event": "meal_time"
        }
      ]
    },
    {
      "id": "proposal_opens",
      "when": {
        "action": "propose"
      },
      "require": [
        {
          "gte": [
            {
              "ref": "$target.resources.SOL"
            },
            {
              "ref": "$params.amount"
            }
          ]
        }
      ],
      "effects": [
        {
          "op": "emit",
          "event": "proposal_opened"
        }
      ]
    },
    {
      "id": "vote_recorded",
      "when": {
        "action": "vote"
      },
      "effects": [
        {
          "op": "emit",
          "event": "vote_cast"
        }
      ]
    },
    {
      "id": "gather_food_yield",
      "when": {
        "action": "gather_food"
      },
      "description": "Employed workers deliver their catch to the firm; the unemployed keep it.",
      "effects": [
        {
          "op": "with",
          "entity": {
            "ref": "$actor.attributes.employer"
          },
          "bind": "$employer",
          "effects": [
            {
              "op": "increment",
              "path": "$employer.resources.food",
              "by": {
                "add": [
                  2,
                  {
                    "mul": [
                      2,
                      {
                        "ref": "$employer.resources.tools"
                      }
                    ]
                  },
                  {
                    "ref": "$actor.attributes.skill"
                  }
                ]
              }
            },
            {
              "op": "emit",
              "event": "worked",
              "data": {
                "kind": "food",
                "forFirm": {
                  "ref": "$employer.id"
                }
              }
            }
          ],
          "else": [
            {
              "op": "increment",
              "path": "$actor.resources.food",
              "by": {
                "add": [
                  2,
                  {
                    "mul": [
                      2,
                      {
                        "ref": "$actor.resources.tools"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "op": "emit",
              "event": "worked",
              "data": {
                "kind": "food"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "gather_wood_yield",
      "when": {
        "action": "gather_wood"
      },
      "description": "Same split for timber.",
      "effects": [
        {
          "op": "with",
          "entity": {
            "ref": "$actor.attributes.employer"
          },
          "bind": "$employer",
          "effects": [
            {
              "op": "increment",
              "path": "$employer.resources.wood",
              "by": {
                "add": [
                  3,
                  {
                    "ref": "$actor.attributes.skill"
                  }
                ]
              }
            },
            {
              "op": "emit",
              "event": "worked",
              "data": {
                "kind": "wood",
                "forFirm": {
                  "ref": "$employer.id"
                }
              }
            }
          ],
          "else": [
            {
              "op": "increment",
              "path": "$actor.resources.wood",
              "by": 3
            },
            {
              "op": "emit",
              "event": "worked",
              "data": {
                "kind": "wood"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "found_company_requires_capital",
      "when": {
        "action": "found_company"
      },
      "description": "Costs capital, and you may own only one company at a time.",
      "require": [
        {
          "gte": [
            {
              "ref": "$actor.resources.SOL"
            },
            {
              "ref": "$params.capital"
            }
          ]
        },
        {
          "gte": [
            {
              "ref": "$params.capital"
            },
            1000
          ]
        },
        {
          "eq": [
            {
              "count": {
                "of": "company",
                "where": {
                  "eq": [
                    {
                      "ref": "$e.attributes.founder"
                    },
                    {
                      "ref": "$actor.id"
                    }
                  ]
                }
              }
            },
            0
          ]
        }
      ],
      "effects": [
        {
          "op": "decrement",
          "path": "$actor.resources.SOL",
          "by": {
            "ref": "$params.capital"
          }
        },
        {
          "op": "spawn",
          "type": "company",
          "bind": "$new",
          "attributes": {
            "name": "Newco",
            "headcount": 0,
            "founder": {
              "ref": "$actor.id"
            },
            "wage": 400
          }
        },
        {
          "op": "increment",
          "path": "$new.resources.SOL",
          "by": {
            "ref": "$params.capital"
          }
        },
        {
          "op": "relate",
          "from": "$actor",
          "to": "$new",
          "kind": "owns"
        },
        {
          "op": "settle",
          "asset": "SOL",
          "from": "$actor",
          "to": "$new",
          "amount": {
            "ref": "$params.capital"
          }
        },
        {
          "op": "emit",
          "event": "company_founded"
        }
      ]
    },
    {
      "id": "hire_takes_one_worker",
      "when": {
        "action": "hire"
      },
      "description": "Employ an unemployed person. Wages are paid each round, not now.",
      "require": [
        {
          "eq": [
            {
              "ref": "$target.attributes.employer"
            },
            null
          ]
        },
        {
          "gte": [
            {
              "ref": "$actor.resources.SOL"
            },
            {
              "mul": [
                2,
                {
                  "ref": "$actor.attributes.wage"
                }
              ]
            }
          ]
        }
      ],
      "effects": [
        {
          "op": "set",
          "path": "$target.attributes.employer",
          "value": {
            "ref": "$actor.id"
          }
        },
        {
          "op": "relate",
          "from": "$target",
          "to": "$actor",
          "kind": "employer"
        },
        {
          "op": "increment",
          "path": "$actor.attributes.headcount",
          "by": 1
        },
        {
          "op": "emit",
          "event": "hired"
        }
      ]
    },
    {
      "id": "payroll",
      "when": {
        "tick": {
          "every": 6
        }
      },
      "description": "Each firm pays its workers, or lays off the ones it cannot pay.",
      "effects": [
        {
          "op": "with",
          "entity": {
            "ref": "$each.person.attributes.employer"
          },
          "bind": "$boss",
          "effects": [
            {
              "op": "with",
              "entity": {
                "ref": "$each.person.attributes.employer"
              },
              "bind": "$employer",
              "require": [
                {
                  "gte": [
                    {
                      "ref": "$employer.resources.SOL"
                    },
                    {
                      "ref": "$employer.attributes.wage"
                    }
                  ]
                }
              ],
              "effects": [
                {
                  "op": "decrement",
                  "path": "$employer.resources.SOL",
                  "by": {
                    "ref": "$employer.attributes.wage"
                  }
                },
                {
                  "op": "increment",
                  "path": "$each.person.resources.SOL",
                  "by": {
                    "ref": "$employer.attributes.wage"
                  }
                },
                {
                  "op": "settle",
                  "asset": "SOL",
                  "from": "$employer",
                  "to": "$each.person",
                  "amount": {
                    "ref": "$employer.attributes.wage"
                  }
                },
                {
                  "op": "emit",
                  "event": "salary_paid"
                }
              ],
              "else": [
                {
                  "op": "set",
                  "path": "$each.person.attributes.employer",
                  "value": null
                },
                {
                  "op": "decrement",
                  "path": "$employer.attributes.headcount",
                  "by": 1
                },
                {
                  "op": "unrelate",
                  "from": "$each.person",
                  "to": "$employer",
                  "kind": "employer"
                },
                {
                  "op": "emit",
                  "event": "laid_off"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "dividend",
      "when": {
        "tick": {
          "every": 12
        }
      },
      "description": "A firm with money left over pays its owner.",
      "effects": [
        {
          "op": "with",
          "entity": {
            "ref": "$each.company.attributes.founder"
          },
          "bind": "$owner",
          "require": [
            {
              "gte": [
                {
                  "ref": "$each.company.resources.SOL"
                },
                2000
              ]
            }
          ],
          "effects": [
            {
              "op": "decrement",
              "path": "$each.company.resources.SOL",
              "by": 1000
            },
            {
              "op": "increment",
              "path": "$owner.resources.SOL",
              "by": 1000
            },
            {
              "op": "settle",
              "asset": "SOL",
              "from": "$each.company",
              "to": "$owner",
              "amount": 1000
            },
            {
              "op": "emit",
              "event": "dividend_paid"
            }
          ]
        }
      ]
    },
    {
      "id": "bankruptcy",
      "when": {
        "tick": {
          "every": 12
        }
      },
      "description": "A firm with no workers and no money dissolves.",
      "effects": [
        {
          "op": "with",
          "entity": {
            "ref": "$each.company.id"
          },
          "bind": "$firm",
          "require": [
            {
              "lt": [
                {
                  "ref": "$firm.resources.SOL"
                },
                200
              ]
            },
            {
              "eq": [
                {
                  "ref": "$firm.attributes.headcount"
                },
                0
              ]
            }
          ],
          "effects": [
            {
              "op": "emit",
              "event": "company_failed",
              "data": {
                "firm": {
                  "ref": "$firm.id"
                }
              }
            },
            {
              "op": "destroy",
              "path": "$firm"
            }
          ]
        }
      ]
    },
    {
      "id": "invest_buys_equity",
      "when": {
        "action": "invest"
      },
      "require": [
        {
          "gte": [
            {
              "ref": "$actor.resources.SOL"
            },
            {
              "ref": "$params.amount"
            }
          ]
        },
        {
          "gt": [
            {
              "ref": "$params.amount"
            },
            0
          ]
        }
      ],
      "effects": [
        {
          "op": "decrement",
          "path": "$actor.resources.SOL",
          "by": {
            "ref": "$params.amount"
          }
        },
        {
          "op": "increment",
          "path": "$target.resources.SOL",
          "by": {
            "ref": "$params.amount"
          }
        },
        {
          "op": "relate",
          "from": "$actor",
          "to": "$target",
          "kind": "shareholder"
        },
        {
          "op": "settle",
          "asset": "SOL",
          "from": "$actor",
          "to": "$target",
          "amount": {
            "ref": "$params.amount"
          }
        },
        {
          "op": "emit",
          "event": "equity_purchased"
        }
      ]
    }
  ],
  "markets": [
    {
      "id": "food_market",
      "resource": "food",
      "currency": "SOL",
      "mechanism": "batch_auction",
      "roundTicks": 6
    },
    {
      "id": "wood_market",
      "resource": "wood",
      "currency": "SOL",
      "mechanism": "batch_auction",
      "roundTicks": 6
    },
    {
      "id": "tools_market",
      "resource": "tools",
      "currency": "SOL",
      "mechanism": "batch_auction",
      "roundTicks": 6
    }
  ],
  "population": [
    {
      "type": "person",
      "count": 18,
      "goals": [
        "Stay fed.",
        "Take paid work when a firm offers it; a wage every round beats foraging.",
        "Save what is left over."
      ]
    },
    {
      "type": "person",
      "count": 6,
      "attributes": {
        "skill": 2
      },
      "goals": [
        "Stay fed, but do not let that be the whole of your life.",
        "You have capital and you mean to use it: found a company and hire people.",
        "A firm you own earns while you sleep. Foraging does not.",
        "You may own only one company, so choose your moment."
      ]
    }
  ],
  "events": [
    {
      "id": "drought",
      "atTick": 200,
      "description": "Food yields collapse for a while.",
      "effects": [
        {
          "op": "emit",
          "event": "shock",
          "data": {
            "kind": "drought"
          }
        }
      ]
    }
  ],
  "metrics": [
    {
      "id": "total_wealth",
      "aggregate": "sum",
      "over": "person",
      "value": {
        "ref": "$e.resources.SOL"
      }
    },
    {
      "id": "wealth_gini",
      "aggregate": "gini",
      "over": "person",
      "value": {
        "ref": "$e.resources.SOL"
      }
    },
    {
      "id": "companies",
      "aggregate": "count",
      "over": "company"
    },
    {
      "id": "mean_food",
      "aggregate": "mean",
      "over": "person",
      "value": {
        "ref": "$e.resources.food"
      }
    }
  ],
  "chain": {
    "cluster": "localnet",
    "currency": "SOL",
    "agentWallets": true,
    "agentRegistry": true,
    "onChainMarkets": true,
    "chainAuthoritative": true,
    "tokens": {
      "SOL": {
        "symbol": "WORLD",
        "decimals": 4,
        "initialSupply": 1000000,
        "fixedSupply": true
      },
      "food": {
        "symbol": "FOOD",
        "decimals": 0
      },
      "wood": {
        "symbol": "WOOD",
        "decimals": 0
      },
      "tools": {
        "symbol": "TOOL",
        "decimals": 0
      }
    },
    "assets": [
      {
        "id": "company_equity",
        "holders": [
          "person"
        ],
        "ownership": "equity_shares"
      }
    ]
  },
  "organizations": [
    {
      "type": "company",
      "memberTypes": [
        "person"
      ],
      "treasuryResource": "SOL",
      "governance": {
        "mechanism": "token_weighted",
        "threshold": 0.5,
        "votingTicks": 12,
        "weightBy": "equity"
      },
      "equityToken": {
        "symbol": "EQTY",
        "decimals": 0,
        "initialSupply": 1000
      }
    }
  ]
}
