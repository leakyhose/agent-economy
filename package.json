{
  "name": "agentic-world",
  "private": true,
  "type": "module",
  "scripts": {
    "sim": "tsx apps/sim/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test:web": "npm --prefix apps/web run test",
    "check:vocab": "npm --prefix apps/web run check:vocab"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  }
}
