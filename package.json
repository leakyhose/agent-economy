{
  "name": "agentic-world",
  "private": true,
  "type": "module",
  "scripts": {
    "sim": "tsx apps/sim/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "demo:solana": "tsx packages/solana/scripts/demo.ts",
    "demo:registry": "tsx packages/solana/scripts/registry-demo.ts",
    "demo:org": "tsx packages/solana/scripts/org-demo.ts",
    "test:chain": "cargo test -p world",
    "test:registry": "cargo test -p registry",
    "test:org": "cargo test -p org",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test:web": "npm --prefix apps/web run test",
    "check:vocab": "npm --prefix apps/web run check:vocab"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0",
    "ws": "^8.18.0"
  }
}
